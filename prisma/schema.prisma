// }

// datasource db {
//   provider = "postgresql"
// }

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Authentication and Authorization
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   // Hashed password slot for Credential accounts
  role          String    @default("USER") // Restricts dashboard access
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @db.ObjectId @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 1. Core Profile Document Collection
model Subscriber {
  id                  String          @id @map("_id") @db.ObjectId
  billingAccountNum   String          @map("billing_account_num")
  telephoneNum        String          @map("telephone_num")
  bbUserId            String          @map("bb_user_id")
  serviceType         String          @map("service_type")
  serviceStartDate    DateTime        @map("service_start_date")
  zone                String
  circle              String
  ba                  String
  ssa                 String
  oltIpAddress        String          @map("olt_ip_address")
  maintFranchiseeCode String          @map("maint_franchisee_code")
  
  // Embedded Document Array native to MongoDB patterns
  billingRecords      BillingRecord[]

  @@index([telephoneNum])
  @@index([bbUserId])
}

// 2. Composite Nested Object Structural Type
type BillingRecord {
  commissionMonth          String   @map("commission_month") // e.g., "JAN-2026"
  invoiceNum               String   @map("invoice_num")
  invoiceDate              DateTime @map("invoice_date")
  totalInvoiceAmount       Float    @map("total_invoice_amount")
  paymentStatus            String   @map("payment_status")
  revenueShareAmtGenerated Float?   @map("revenue_share_amt_generated")
  remarks                  String?
}

// 🛠️ 2. Isolated Leased Line / Leased Circuits Collection
model LeasedLine {
  id                  String             @id @map("_id")
  billingAccountNum   String             @map("billing_account_num")
  lcId                String             @unique @map("lc_id") // Leased Circuit ID parameter flag
  serviceSubtype      String             @map("service_subtype") // e.g., MPLS VPN LC, P2P LC
  bandwidth           String             @map("bandwidth") // e.g., 2 MBPS, 4 MBPS
  serviceStartDate    DateTime           @map("service_start_date")
  zone                String
  circle              String
  ba                  String
  ssa                 String
  oltIpAddress        String             @map("olt_ip_address")
  maintFranchiseeCode String             @map("maint_franchisee_code")
  billingRecords      LLBillingRecord[]

  @@index([billingAccountNum])    // Index kept for fast searching lookups instead of unique constraints
}

type LLBillingRecord {
  commissionMonth          String   @map("commission_month") // Maps directly to CHARGE MONTH row items
  invoiceNum               String   @map("invoice_num")
  invoiceDate              DateTime @map("invoice_date")
  totalInvoiceAmount       Float    @map("total_invoice_amount")
  paymentStatus            String   @map("payment_status")
  revenueShareAmtGenerated Float?   @map("revenue_share_amt_generated")
  remarks                  String?
}

model TwoFactorToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expires   DateTime

  @@unique([email, token])
}

